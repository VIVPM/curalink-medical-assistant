# ============================================================
# Curalink FastAPI orchestrator - environment template
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# --- Service config ---
PORT=8000

# --- Redis (optional) ---
# Enables the embedding cache. Unset = cache disabled (pipeline runs normally).
# Upstash gives a rediss:// URL. LLM_CONCURRENCY (default 3) tunes HF throttling.
REDIS_URL=

# --- LLM provider (required, no fallback) ---
# CLOUDFLARE  -> needs CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN
# <hf-model>  -> e.g. meta-llama/Llama-3.1-8B-Instruct, needs HF_TOKEN
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# HuggingFace (when LLM_MODEL is a HF model id)
HF_TOKEN=

# Cloudflare Workers AI (gpt-oss-20b, when LLM_MODEL=CLOUDFLARE)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- PubMed (NCBI E-utilities) ---
# NCBI_API_KEY is optional but strongly recommended:
#   without key -> 3 req/sec  (429 errors during demo)
#   with key    -> 10 req/sec (safe)
# Free signup: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=curalink

# --- OpenAlex (no key, polite User-Agent only) ---
OPENALEX_EMAIL=

# --- Embedding + reranking models (downloaded on first run, cached locally) ---
BIENCODER_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
CROSS_ENCODER_MODEL=ncbi/MedCPT-Cross-Encoder

# --- Observability (optional; Langfuse LLM traces + Grafana OTLP) ---
# All no-op unless set. Langfuse = LLM generation traces; Grafana = HTTP spans +
# a chat_messages_total metric. Langfuse keys: cloud.langfuse.com. Grafana:
# GRAFANA_OTLP_ENDPOINT is the .../otlp gateway; GRAFANA_OTLP_AUTH is the full
# "Basic <base64>" header value.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
OTEL_SERVICE_NAME=curalink-research-assistant
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_AUTH=
