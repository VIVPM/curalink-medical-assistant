# ============================================================
# Curalink FastAPI orchestrator - environment template
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# --- Service config ---
PORT=8000
# REQUIRED. Must match the Express service; generate: openssl rand -hex 32
INTERNAL_API_KEY=
# Required for saved-provider background jobs: trusted Express service base URL.
# Use HTTPS or a private service network in deployment.
NODE_API_URL=http://localhost:4000

# --- Redis (optional) ---
# Enables the embedding cache. Unset = cache disabled (pipeline runs normally).
# Upstash gives a rediss:// URL. LLM_CONCURRENCY (default 3) tunes HF throttling.
REDIS_URL=

# --- LLM provider (required, no fallback) ---
# CLOUDFLARE  -> needs CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN
# <hf-model>  -> e.g. meta-llama/Llama-3.1-8B-Instruct, needs HF_TOKEN
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# HuggingFace (when LLM_MODEL is a HF model id)
HF_TOKEN=

# Cloudflare Workers AI (gpt-oss-20b, when LLM_MODEL=CLOUDFLARE)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Optional Jev routing ---
# Set a TypeSafe AI key to enable history/RAG routing and Llama 8B/70B selection.
# Without a key, the existing single-model pipeline is unchanged.
# Enabling sends intake context, the question, and bounded history/source excerpts
# to TypeSafe AI. Check provider data-handling terms before enabling.
JEV_API_KEY=
# Models remain on the request's selected provider, including user-owned keys.
HF_LLM_8B_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_LLM_70B_MODEL=meta-llama/Llama-3.3-70B-Instruct
CF_LLM_8B_MODEL=@cf/openai/gpt-oss-20b
CF_LLM_70B_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# --- PubMed (NCBI E-utilities) ---
# NCBI_API_KEY is optional but strongly recommended:
#   without key -> 3 req/sec  (429 errors during demo)
#   with key    -> 10 req/sec (safe)
# Free signup: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=curalink

# --- OpenAlex (no key, polite User-Agent only) ---
OPENALEX_EMAIL=

# --- Embedding + reranking models (downloaded on first run, cached locally) ---
BIENCODER_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
CROSS_ENCODER_MODEL=ncbi/MedCPT-Cross-Encoder

# --- Observability (optional; Langfuse LLM traces) ---
# Langfuse receives model/timing metadata only; prompt and output content
# are never exported. Keys: cloud.langfuse.com.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
OTEL_SERVICE_NAME=curalink-research-assistant
