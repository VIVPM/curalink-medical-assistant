# ============================================================
# Curalink Express/Node backend - environment template
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# --- Service config ---
PORT=4000
NODE_ENV=development

# --- MongoDB Atlas ---
# Free M0 cluster connection string
MONGO_URI=

# --- Downstream FastAPI orchestrator ---
# FASTAPI_URL=http://localhost:8000
FASTAPI_URL=https://curalink-medical-assistant-python.onrender.com

# --- Auth ---
# REQUIRED. Long random string for signing JWTs. The server refuses to boot
# without it (no insecure default). Generate: openssl rand -hex 32
JWT_SECRET=

# --- CORS ---
# Comma-separated allow-list of frontend origins. Defaults to the deployed
# frontend + localhost:5173 if unset.
ALLOWED_ORIGINS=http://localhost:5173,https://curalink-medical-assistant-frontend.onrender.com

# --- Redis (optional) ---
# Enables the query-result cache in Redis (falls back to MongoDB if unset).
# Upstash gives a rediss:// URL.
REDIS_URL=
