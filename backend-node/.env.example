# ============================================================
# Curalink Express/Node backend - environment template
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# --- Service config ---
PORT=4000
NODE_ENV=development

# --- Neon Postgres ---
# Connection string for the curalink database; tables are created on startup
DATABASE_URL=postgresql://user:password@host/curalink?sslmode=verify-full

# --- Downstream FastAPI orchestrator ---
# FASTAPI_URL=http://localhost:8000
FASTAPI_URL=https://curalink-medical-assistant-python.onrender.com
# REQUIRED. Must match the FastAPI service; generate: openssl rand -hex 32
INTERNAL_API_KEY=

# --- Auth ---
# REQUIRED. Long random string for signing JWTs. The server refuses to boot
# without it (no insecure default). Generate: openssl rand -hex 32
JWT_SECRET=

# --- CORS ---
# Comma-separated allow-list of frontend origins. Defaults to the deployed
# frontend + localhost:5173 if unset.
ALLOWED_ORIGINS=http://localhost:5173

# --- Redis (optional) ---
# Enables the query-result cache in Redis (falls back to Postgres if unset).
# Upstash gives a rediss:// URL.
REDIS_URL=
